rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if request.auth != null && resource.data.artisanId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.artisanId == request.auth.uid;
      allow update: if request.auth != null && resource.data.artisanId == request.auth.uid && request.resource.data.artisanId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.artisanId == request.auth.uid;
    }
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.artisanId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.artisanId == request.auth.uid;
      allow update: if request.auth != null && resource.data.artisanId == request.auth.uid && request.resource.data.artisanId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.artisanId == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
